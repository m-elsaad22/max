# WordPress application password for max-art-ae.com
# Copy to .env and fill WP_APP_PASSWORD. Never commit the real password.
# Aliases also accepted: WP_BASE_URL, WP_USERNAME

WP_URL=https://max-art-ae.com
WP_USER=mahmoud
WP_APP_PASSWORD=

# Absolute WordPress document root on the server that hosts the files.
# Required for scripts/phase2_cleanup.py Task 1 (sitemap + inactive plugin delete).
